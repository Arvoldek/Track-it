<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	
	<key>CFBundleDisplayName</key>
	<string>Track It</string>
	
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	
	<key>CFBundleIdentifier</key>
	<string>com.arvoldek.TrackIt</string>
	
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	
	<key>CFBundleVersion</key>
	<string>1</string>
	
	<key>CFBundleURLTypes</key>
	<array/>
	
	<!-- Required for iCloud -->
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.com.arvoldek.TrackIt</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<false/>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
			<key>NSUbiquitousContainerName</key>
			<string>TrackIt</string>
		</dict>
	</dict>
	
	<!-- iCloud Capabilities -->
	<key>NSSupportsLiveActivities</key>
	<false/>
	
	<!-- Background Modes -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	
	<!-- User Notifications -->
	<key>UIUserNotificationAlertStyle</key>
	<string>alert</string>
	
	<!-- Privacy Descriptions -->
	<key>NSUserTrackingUsageDescription</key>
	<string>Track It uses iCloud to sync your trackers across devices. This helps keep your data in sync on all your Apple devices.</string>
	
	<key>NSCalendarsUsageDescription</key>
	<string>Track It needs access to calendars to set reminders for your tracking goals.</string>
	
	<key>NSRemindersUsageDescription</key>
	<string>Track It needs access to reminders to set tracker notifications and help you stay on track.</string>
	
	<key>NSAppleMusicUsageDescription</key>
	<string>Track It needs access to Apple Music to play sounds with your notifications.</string>
	
	<!-- Week Start Setting -->
	<key>NSLocaleCalendar</key>
	<string>gregorian</string>
	
	<!-- App Transport Security -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSExceptionDomains</key>
		<dict/>
		<key>NSAllowsLocalNetworking</key>
		<false/>
	</dict>
	
	<!-- UI Configuration -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>LaunchScreen</string>
				</dict>
			</array>
		</dict>
	</dict>
	
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDefault</string>
	
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	
	<!-- Minimum OS Version -->
	<key>MinimumOSVersion</key>
	<string>17.0</string>
	
	<!-- Swift Version -->
	<key>SwiftVersion</key>
	<string>5.0</string>
	
	<!-- Scene Support -->
	<key>UISceneSupportedInterfaceOrientations</key>
	<array/>
	
	<key>UISceneSupportedInterfaceOrientations~ipad</key>
	<array/>
</dict>
</plist>

// App.xcconfig - Common settings for all configurations

// Project Identity
PRODUCT_NAME = "Track It"
PRODUCT_BUNDLE_IDENTIFIER = com.arvoldek.TrackIt

// Deployment
IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1,2

// Swift Configuration
SWIFT_VERSION = 5.0
SWIFT_OPTIMIZATION_LEVEL = -Onone

// Code Signing
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = 

// Frameworks
ENABLE_BITCODE = NO
CLANG_ENABLE_MODULES = YES

// Warnings
GCC_WARN_64_TO_32_BIT_CONVERSION = YES
GCC_WARN_ABOUT_RETURN_TYPE = YES
GCC_WARN_UNDECLARED_SELECTOR = YES
GCC_WARN_UNUSED_FUNCTION = YES
GCC_WARN_UNUSED_VARIABLE = YES

// Debug Information
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
GENERATE_TEST_COVERAGE_FILES = YES
ENABLE_TESTABILITY = YES

// Localization
DEVELOPMENT_LANGUAGE = en

// Assets
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOLS = YES
